---
import '../styles/global.css';
import Palette, { type PaletteItem } from '../components/Palette.astro';
import { site } from '../data/site';
import { publications } from '../data/publications';
import { projects } from '../data/projects';
import { getPosts } from '../lib/posts';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  /** Article and utility pages get the quiet shell; the home page draws its own. */
  shell?: boolean;
}
const { title, description = site.description, type = 'website', shell = true } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : site.name;
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = new URL('/universe/og.jpg', site.url).href;

const posts = await getPosts();
const items: PaletteItem[] = [
  { label: 'Origin', hint: 'set course', href: '/#top' },
  { label: 'About', hint: 'set course', href: '/#about' },
  { label: 'Research', hint: 'set course', href: '/#research' },
  { label: 'Projects', hint: 'set course', href: '/#projects' },
  { label: 'Experience', hint: 'set course', href: '/#experience' },
  { label: 'Explorations', hint: 'set course', href: '/#explorations' },
  { label: 'Contact', hint: 'set course', href: '/#contact' },
  { label: 'Open the system chart', hint: 'action', action: 'chart' },
  { label: 'Writing', hint: 'page', href: '/blog/' },
  ...publications.map(p => ({ label: p.title, hint: 'paper', href: p.links[0]?.href, external: true })),
  ...publications.map(p => ({ label: `Copy BibTeX: ${p.title}`, hint: 'action', action: 'copy-text', text: p.bibtex })),
  ...projects.map(p => ({ label: p.name, hint: 'project', href: p.href, external: true })),
  ...posts.map(p => ({ label: p.data.title, hint: 'post', href: `/blog/${p.id}/` })),
  ...site.links.map(l => ({ label: l.label, hint: 'link', href: l.href, external: true })),
  { label: 'RSS feed', hint: 'link', href: '/rss.xml' },
  { label: 'Copy link to this page', hint: 'action', action: 'copy-link' },
];
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: site.url,
  description: site.description,
  sameAs: site.links.filter(l => !l.label.includes('arXiv')).map(l => l.href),
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#030406" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="alternate" type="application/rss+xml" title={site.name} href="/rss.xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{pageTitle}</title>
    <script is:inline>document.documentElement.classList.add('js')</script>
    <script type="application/ld+json" set:html={JSON.stringify(person)}></script>
    <slot name="head" />
  </head>
  <body class={shell ? 'shell' : ''}>
    {shell && (
      <div class="shell-sky" aria-hidden="true"></div>
      <header class="bar">
        <a class="brand" href="/">{site.name}</a>
        <nav aria-label="Main">
          <a href="/#about">About</a>
          <a href="/#research">Research</a>
          <a href="/#projects">Projects</a>
          <a href="/blog/">Writing</a>
          <a href="/#contact">Contact</a>
        </nav>
      </header>
    )}
    <slot name="chrome" />
    <main id="main"><slot /></main>
    {shell && (
      <footer class="foot">
        <span>© {new Date().getFullYear()} {site.name}</span>
        <span><a href="/rss.xml">RSS</a> · <a href={site.repo}>Source</a> · <kbd>/</kbd> to search</span>
      </footer>
    )}
    <Palette items={items} />
    <div id="toast" role="status" aria-live="polite"></div>

    <script>
      const toastEl = document.getElementById('toast')!;
      let toastTimer: number | undefined;
      document.addEventListener('toast', e => {
        toastEl.textContent = (e as CustomEvent<string>).detail;
        toastEl.classList.add('show');
        clearTimeout(toastTimer);
        toastTimer = window.setTimeout(() => toastEl.classList.remove('show'), 2200);
      });

      // Copy buttons: <button data-copy="text">.
      document.addEventListener('click', e => {
        const btn = (e.target as Element).closest('[data-copy]') as HTMLButtonElement | null;
        if (!btn) return;
        navigator.clipboard.writeText(btn.dataset.copy || '').then(() => {
          const old = btn.textContent;
          btn.textContent = 'Copied';
          setTimeout(() => (btn.textContent = old), 1500);
        });
      });

      // ↑ ↑ ↓ ↓ ← → ← → b a: four gravitational waves, and one honest loss value.
      const code = ['ArrowUp','ArrowUp','ArrowDown','ArrowDown','ArrowLeft','ArrowRight','ArrowLeft','ArrowRight','b','a'];
      let pos = 0;
      document.addEventListener('keydown', e => {
        pos = e.key === code[pos] ? pos + 1 : e.key === code[0] ? 1 : 0;
        if (pos === code.length) {
          pos = 0;
          document.dispatchEvent(new CustomEvent('descend-burst'));
          document.dispatchEvent(new CustomEvent('toast', { detail: 'loss: 0.0000 (converged)' }));
        }
      });
    </script>
  </body>
</html>
