---
import 'katex/dist/katex.min.css';

interface Props {
  title?: string;
  description?: string;
}
const { title, description = 'Applied AI researcher.' } = Astro.props;
const pageTitle = title ? `${title} - Raunak Bhagate` : 'Raunak Bhagate';
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href={`${base}favicon.png`} />
    <link rel="icon" type="image/svg+xml" sizes="any" href={`${base}favicon.svg`} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header>
      <a href="/">Raunak Bhagate</a>
      <nav>
        <a href="/blog/">Writing</a>
      </nav>
    </header>
    <main><slot /></main>
    <style is:global>
      :root { color-scheme: light dark; font-family: system-ui, sans-serif; }
      body { max-width: 42rem; margin: 0 auto; padding: 1.5rem; line-height: 1.7; }
      header { display: flex; justify-content: space-between; margin-bottom: 3rem; }
    </style>
  </body>
</html>
