<canvas id="bg" class="bg" aria-hidden="true"></canvas>

<script>
  // "Loss landscape" background: a slowly drifting scalar field drawn as
  // topographic contours (marching squares). Click anywhere to release a
  // gradient-descent ball that rolls into the nearest valley and leaves a trail.
  const canvas = document.getElementById('bg') as HTMLCanvasElement | null;
  const ctx = canvas?.getContext('2d');

  if (canvas && ctx) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    const store = {
      get() { try { return localStorage.getItem('bg'); } catch { return null; } },
      set(v: string) { try { localStorage.setItem('bg', v); } catch {} },
    };

    let enabled = store.get() !== 'off';
    let W = 0, H = 0, asp = 1, cell = 16, cols = 0, rows = 0;
    let grid = new Float32Array(0);
    let t = 40;
    let contour = '0 0 0', contourA = 0.085, accent = '47 75 214';

    type Well = { x: number; y: number; rx: number; ry: number; fx: number; fy: number; px: number; py: number; a: number; s: number };
    const wells: Well[] = [
      { x: 0.25, y: 0.35, rx: 0.12, ry: 0.10, fx: 0.050, fy: 0.037, px: 0.0, py: 1.3, a: -1.0, s: 0.15 },
      { x: 0.72, y: 0.60, rx: 0.14, ry: 0.12, fx: 0.041, fy: 0.056, px: 2.1, py: 0.4, a: -0.9, s: 0.18 },
      { x: 0.50, y: 0.15, rx: 0.20, ry: 0.07, fx: 0.032, fy: 0.047, px: 4.0, py: 2.2, a: 0.7, s: 0.17 },
      { x: 0.85, y: 0.20, rx: 0.08, ry: 0.10, fx: 0.060, fy: 0.030, px: 1.0, py: 3.1, a: -0.6, s: 0.12 },
      { x: 0.35, y: 0.85, rx: 0.15, ry: 0.06, fx: 0.036, fy: 0.052, px: 5.2, py: 0.9, a: 0.6, s: 0.16 },
    ];

    // Cursor attracts a shallow well of its own.
    let mx = 0.5, my = 0.5, tx = 0.5, ty = 0.5, mStrength = 0, mTarget = 0, lastMove = 0;

    const field = (u: number, v: number, time: number): number => {
      let f = 0;
      for (const w of wells) {
        const cx = (w.x * asp) + w.rx * Math.sin(time * w.fx + w.px);
        const cy = w.y + w.ry * Math.cos(time * w.fy + w.py);
        const dx = u - cx, dy = v - cy;
        const sp = w.s * 1.45;
        f += w.a * Math.exp(-(dx * dx + dy * dy) / (2 * sp * sp));
      }
      f += 0.14 * Math.sin(u * 6.5 + time * 0.04) * Math.cos(v * 5.5 - time * 0.03);
      if (mStrength > 0.01) {
        const dx = u - mx * asp, dy = v - my;
        f -= 0.8 * mStrength * Math.exp(-(dx * dx + dy * dy) / (2 * 0.09 * 0.09));
      }
      return f;
    };

    const readColors = () => {
      const cs = getComputedStyle(document.documentElement);
      contour = cs.getPropertyValue('--contour-rgb').trim() || contour;
      contourA = parseFloat(cs.getPropertyValue('--contour-a')) || contourA;
      accent = cs.getPropertyValue('--accent-rgb').trim() || accent;
    };

    const resize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      W = window.innerWidth; H = window.innerHeight; asp = W / H;
      canvas.width = Math.round(W * dpr); canvas.height = Math.round(H * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      cell = W < 700 ? 20 : 16;
      cols = Math.ceil(W / cell) + 2; rows = Math.ceil(H / cell) + 2;
      grid = new Float32Array(cols * rows);
    };

    // Marching squares. Corners: a=TL(8) b=TR(4) c=BR(2) d=BL(1).
    // Each case lists edge pairs: 0=top 1=right 2=bottom 3=left.
    const CASES: number[][] = [
      [], [3, 2], [2, 1], [3, 1], [0, 1], [0, 1, 3, 2], [0, 2], [0, 3],
      [0, 3], [0, 2], [0, 3, 2, 1], [0, 1], [3, 1], [2, 1], [3, 2], [],
    ];

    const drawContours = () => {
      for (let j = 0; j < rows; j++) {
        const v = (j * cell) / H;
        for (let i = 0; i < cols; i++) grid[j * cols + i] = field((i * cell) / H, v, t);
      }
      const levelsFrom = -1.3, step = 0.1, count = 24;
      for (const index of [false, true]) {
        ctx.beginPath();
        for (let k = 0; k < count; k++) {
          if ((k % 5 === 0) !== index) continue;
          const L = levelsFrom + k * step;
          for (let j = 0; j < rows - 1; j++) {
            for (let i = 0; i < cols - 1; i++) {
              const a = grid[j * cols + i], b = grid[j * cols + i + 1];
              const c = grid[(j + 1) * cols + i + 1], d = grid[(j + 1) * cols + i];
              const idx = (a > L ? 8 : 0) | (b > L ? 4 : 0) | (c > L ? 2 : 0) | (d > L ? 1 : 0);
              const segs = CASES[idx];
              if (!segs.length) continue;
              const x0 = i * cell, y0 = j * cell;
              const pt = (e: number): [number, number] => {
                if (e === 0) return [x0 + cell * (L - a) / (b - a), y0];
                if (e === 1) return [x0 + cell, y0 + cell * (L - b) / (c - b)];
                if (e === 2) return [x0 + cell * (L - d) / (c - d), y0 + cell];
                return [x0, y0 + cell * (L - a) / (d - a)];
              };
              for (let s = 0; s < segs.length; s += 2) {
                const p = pt(segs[s]), q = pt(segs[s + 1]);
                ctx.moveTo(p[0], p[1]); ctx.lineTo(q[0], q[1]);
              }
            }
          }
        }
        ctx.lineWidth = index ? 1.1 : 0.6;
        ctx.strokeStyle = `rgb(${contour} / ${index ? contourA * 1.9 : contourA})`;
        ctx.stroke();
      }
    };

    // Gradient-descent balls.
    type Ball = { u: number; v: number; vu: number; vv: number; trail: number[]; age: number; end: number };
    const balls: Ball[] = [];
    const spawn = (px: number, py: number) => {
      if (balls.length >= 18) balls.shift();
      balls.push({ u: px / H, v: py / H, vu: 0, vv: 0, trail: [], age: 0, end: 0 });
    };
    const grad = (u: number, v: number): [number, number] => {
      const e = 0.004;
      return [
        (field(u + e, v, t) - field(u - e, v, t)) / (2 * e),
        (field(u, v + e, t) - field(u, v - e, t)) / (2 * e),
      ];
    };
    const stepBalls = (dt: number) => {
      const n = Math.max(1, Math.round(dt * 30));
      for (let b = balls.length - 1; b >= 0; b--) {
        const ball = balls[b];
        ball.age += dt;
        if (!ball.end) {
          for (let s = 0; s < n; s++) {
            const [gu, gv] = grad(ball.u, ball.v);
            ball.vu = 0.9 * ball.vu - 0.00015 * gu;
            ball.vv = 0.9 * ball.vv - 0.00015 * gv;
            ball.u += ball.vu; ball.v += ball.vv;
          }
          ball.trail.push(ball.u, ball.v);
          if (ball.trail.length > 360) ball.trail.splice(0, 2);
          const speed = Math.hypot(ball.vu, ball.vv);
          if ((ball.age > 1.2 && speed < 0.0006) || ball.age > 9) ball.end = ball.age;
        } else if (ball.age - ball.end > 2.5) balls.splice(b, 1);
      }
    };
    const drawBalls = () => {
      for (const ball of balls) {
        const fade = ball.end ? Math.max(0, 1 - (ball.age - ball.end) / 2.5) : 1;
        const tr = ball.trail;
        if (tr.length >= 4) {
          ctx.beginPath();
          ctx.moveTo(tr[0] * H, tr[1] * H);
          for (let k = 2; k < tr.length; k += 2) ctx.lineTo(tr[k] * H, tr[k + 1] * H);
          ctx.lineWidth = 1.4;
          ctx.lineCap = 'round';
          ctx.strokeStyle = `rgb(${accent} / ${0.5 * fade})`;
          ctx.stroke();
        }
        ctx.beginPath();
        ctx.arc(ball.u * H, ball.v * H, 3, 0, Math.PI * 2);
        ctx.fillStyle = `rgb(${accent} / ${0.85 * fade})`;
        ctx.fill();
      }
    };

    let raf = 0, last = 0, nextAmbient = 3;
    const render = () => {
      ctx.clearRect(0, 0, W, H);
      drawContours();
      drawBalls();
    };
    const frame = (ts: number) => {
      raf = requestAnimationFrame(frame);
      const el = ts - last;
      if (el < 32) return;
      last = ts;
      const dt = Math.min(0.1, el / 1000);
      t += dt * 0.6;
      mx += (tx - mx) * 0.08; my += (ty - my) * 0.08;
      if (performance.now() - lastMove > 2500) mTarget = 0;
      mStrength += (mTarget - mStrength) * 0.05;
      nextAmbient -= dt;
      if (nextAmbient <= 0) {
        if (balls.length < 2) spawn(Math.random() * W, Math.random() * H);
        nextAmbient = 6 + Math.random() * 4;
      }
      stepBalls(dt);
      render();
    };

    const animated = () => enabled && !reduce.matches && !document.hidden;
    const start = () => { if (!raf && animated()) raf = requestAnimationFrame(frame); };
    const stop = () => { cancelAnimationFrame(raf); raf = 0; };
    const sync = () => {
      canvas.hidden = !enabled;
      stop();
      if (!enabled) return;
      resize(); readColors();
      if (reduce.matches) { balls.length = 0; render(); } else start();
    };

    window.addEventListener('resize', () => { if (enabled) { resize(); if (!raf) render(); } });
    document.addEventListener('visibilitychange', () => { stop(); start(); });
    reduce.addEventListener('change', sync);
    document.addEventListener('themechange', () => { readColors(); if (enabled && !raf) render(); });
    matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => setTimeout(() => { readColors(); if (enabled && !raf) render(); }, 0));

    window.addEventListener('pointermove', e => {
      if (e.pointerType !== 'mouse' || !enabled) return;
      tx = e.clientX / W; ty = e.clientY / H; mTarget = 1; lastMove = performance.now();
    }, { passive: true });
    window.addEventListener('pointerdown', e => {
      if (!enabled || reduce.matches || e.button !== 0) return;
      const el = e.target as Element;
      if (el.closest('a, button, input, textarea, select, summary, dialog, pre, canvas, label, [role="button"]')) return;
      spawn(e.clientX, e.clientY);
    });
    document.addEventListener('toggle-bg', () => {
      enabled = !enabled;
      store.set(enabled ? 'on' : 'off');
      sync();
      document.dispatchEvent(new CustomEvent('toast', { detail: enabled ? 'Background on' : 'Background off' }));
    });
    document.addEventListener('descend-burst', () => {
      if (!enabled || reduce.matches) return;
      for (let k = 0; k < 18; k++) spawn(Math.random() * W, Math.random() * H);
    });

    sync();
  }
</script>
